# --- INFORMAZIONI PROGETTO ---

PROJECT_NAME = "shrink"
PROJECT_NUMBER = "v1.0.0"
PROJECT_BRIEF = "Fast, multithreaded CLI image compression tool written in C++23"
OUTPUT_DIRECTORY = "docs"
CREATE_SUBDIRS = NO
OUTPUT_LANGUAGE = English

# --- SORGENTI E INCUDES ---

INPUT = include src README.md
RECURSIVE = YES
FILE*PATTERNS = *.hpp _.cpp _.h \_.c \*.md
USE_MDFILE_AS_MAINPAGE = README.md

# --- ESTRAZIONE ED DOCUMENTAZIONE ---

EXTRACT_ALL = YES
EXTRACT_PRIVATE = YES
EXTRACT_STATIC = YES
CASE_SENSE_NAMES = YES
HIDE_UNDOC_MEMBERS = NO
SHOW_INCLUDE_FILES = YES

# --- INTEGRATING DOXYGEN AWESOME THEME ---

GENERATE_TREEVIEW = YES
DISABLE_INDEX = NO
FULL_SIDEBAR = YES
HTML_EXTRA_STYLESHEET = doxygen-awesome-css/doxygen-awesome.css
HTML_COLORSTYLE = LIGHT # Supporta sia Light che Dark tramite browser

# --- FORMATI DI OUTPUT ---

GENERATE_HTML = YES
HTML_OUTPUT = html
GENERATE_LATEX = NO
GENERATE_XML = NO

# --- GRAFICI E DIAGRAMMI (Opzionale: richiede 'graphviz' installato nel sistema) ---

HAVE_DOT = NO
CLASS_GRAPH = YES
COLLABORATION_GRAPH = YES
INCLUDE_GRAPH = YES
INCLUDED_BY_GRAPH = YES
CALL_GRAPH = YES
